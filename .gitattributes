# Windows-Batchdateien brauchen CRLF, sonst bricht cmd.exe bei Labels und Sprüngen.
*.cmd text eol=crlf
*.bat text eol=crlf

# Alles andere mit LF im Repository.
*.js   text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.yml  text eol=lf
LICENSE text eol=lf

# Skripte für den Server MÜSSEN LF behalten. Mit CRLF sucht der Kernel einen
# Interpreter namens "/bin/sh\r" und meldet "bad interpreter" — ein Fehler,
# der wie ein fehlendes sh aussieht und keiner ist.
*.sh   text eol=lf
*.php  text eol=lf

# Was NICHT ins Release-ZIP gehört (git archive wertet das aus).
/test           export-ignore
/tools          export-ignore
/CLAUDE.md      export-ignore
/docs           export-ignore
/.github        export-ignore
/.gitattributes export-ignore
/.gitignore     export-ignore
